<% content_for :title, "Novo Agendamento Manual" %>

<div class="max-w-3xl space-y-6">
  <div>
    <h2 class="text-xl font-bold text-slate-900">Registrar Agendamento Manual</h2>
    <p class="text-xs text-slate-500">Agende diretamente pelo painel para clientes que ligaram ou pediram pelo WhatsApp.</p>
  </div>

  <%= form_with url: admin_bookings_path, method: :post, class: "space-y-6" do |f| %>
    <div class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <%= label_tag :service_id, "Serviço", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
          <%= select_tag :service_id, options_for_select(@services.map { |s| ["#{s.name} (#{s.duration_minutes}min · #{s.formatted_price})", s.id] }), required: true, class: "w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm bg-white" %>
        </div>

        <div>
          <%= label_tag :staff_member_id, "Profissional", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
          <%= select_tag :staff_member_id, options_for_select([["Qualquer profissional disponível", ""]] + @staff_members.map { |s| [s.name, s.id] }), class: "w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm bg-white" %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <%= label_tag :starts_at, "Data e Horário de Início", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
          <%= datetime_local_field_tag :starts_at, (Time.current + 1.hour).strftime("%Y-%m-%dT%H:00"), required: true, class: "w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" %>
        </div>
      </div>

      <div class="pt-4 border-t border-slate-100 space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Dados do Cliente</h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <%= label_tag :client_name, "Nome Completo", class: "block text-[11px] font-bold text-slate-600 mb-1" %>
            <%= text_field_tag :client_name, nil, required: true, placeholder: "Nome do cliente", class: "w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm" %>
          </div>

          <div>
            <%= label_tag :client_email, "E-mail (para confirmação)", class: "block text-[11px] font-bold text-slate-600 mb-1" %>
            <%= email_field_tag :client_email, nil, required: true, placeholder: "cliente@email.com", class: "w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm" %>
          </div>

          <div>
            <%= label_tag :client_phone, "Telefone / WhatsApp", class: "block text-[11px] font-bold text-slate-600 mb-1" %>
            <%= telephone_field_tag :client_phone, nil, placeholder: "(11) 99999-9999", class: "w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm" %>
          </div>
        </div>
      </div>

      <div>
        <%= label_tag :notes, "Observações internas (opcional)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
        <%= text_area_tag :notes, nil, rows: 2, placeholder: "Detalhes informados pelo cliente...", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm" %>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3">
      <%= link_to "Cancelar", admin_bookings_path, class: "px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-100" %>
      <%= f.submit "Confirmar Agendamento", class: "px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold shadow-md shadow-indigo-600/30 cursor-pointer" %>
    </div>
  <% end %>
</div>
