<% content_for :title, "Dashboard" %>

<div class="space-y-6 sm:space-y-8">
  <!-- Public Page Callout Banner -->
  <div class="p-5 sm:p-6 rounded-3xl bg-gradient-to-r from-indigo-900 via-indigo-950 to-slate-900 border border-indigo-500/30 text-white shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-5">
    <div class="space-y-1.5">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Sua Página Pública está Online
      </div>
      <h2 class="text-lg sm:text-xl font-bold">Compartilhe sua agenda com seus clientes</h2>
      <p class="text-xs text-indigo-200">Envie no WhatsApp, Instagram Bio ou no seu site para que seus clientes agendem sozinhos 24/7.</p>
    </div>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 w-full md:w-auto">
      <div class="bg-slate-950/80 px-3.5 py-2.5 rounded-xl border border-indigo-500/30 text-xs text-indigo-200 font-mono truncate max-w-full sm:max-w-xs select-all text-center sm:text-left">
        <%= public_booking_url(slug: current_account.slug) %>
      </div>
      <%= link_to public_booking_path(slug: current_account.slug), target: "_blank", class: "px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold rounded-xl transition-all shadow-md shadow-indigo-600/30 shrink-0 flex items-center justify-center gap-1.5 min-h-[40px]" do %>
        <span>Abrir Página</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      <% end %>
    </div>
  </div>

  <!-- Metric KPI Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
    <div class="bg-white p-5 sm:p-6 rounded-3xl border border-slate-200/80 shadow-xs hover:shadow-sm transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Hoje</span>
        <span class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold">📅</span>
      </div>
      <p class="text-3xl font-extrabold text-slate-900 mt-3 sm:mt-4"><%= @today_bookings.count %></p>
      <p class="text-xs text-slate-500 mt-1">agendamento(s) para hoje</p>
    </div>

    <div class="bg-white p-5 sm:p-6 rounded-3xl border border-slate-200/80 shadow-xs hover:shadow-sm transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Mês Atual</span>
        <span class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">📈</span>
      </div>
      <p class="text-3xl font-extrabold text-slate-900 mt-3 sm:mt-4"><%= @monthly_bookings_count %></p>
      <p class="text-xs text-slate-500 mt-1">agendamentos este mês</p>
    </div>

    <div class="bg-white p-5 sm:p-6 rounded-3xl border border-slate-200/80 shadow-xs hover:shadow-sm transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Base de Clientes</span>
        <span class="w-9 h-9 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center font-bold">👥</span>
      </div>
      <p class="text-3xl font-extrabold text-slate-900 mt-3 sm:mt-4"><%= @total_clients_count %></p>
      <p class="text-xs text-slate-500 mt-1">clientes cadastrados</p>
    </div>

    <div class="bg-white p-5 sm:p-6 rounded-3xl border border-slate-200/80 shadow-xs hover:shadow-sm transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Estrutura</span>
        <span class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">⚙️</span>
      </div>
      <p class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-3 sm:mt-4"><%= @total_services_count %> <span class="text-sm font-semibold text-slate-400">serviços</span></p>
      <p class="text-xs text-slate-500 mt-1"><%= @total_staff_count %> profissional(is) ativos</p>
    </div>
  </div>

  <!-- Today and Upcoming Split -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
    <!-- Today's Schedule -->
    <div class="bg-white p-5 sm:p-6 rounded-3xl border border-slate-200/80 shadow-xs">
      <div class="flex items-center justify-between mb-5 sm:mb-6">
        <div>
          <h3 class="text-base font-bold text-slate-900">Agenda de Hoje</h3>
          <p class="text-xs text-slate-500"><%= l(Date.current, format: "%A, %d de %B") %></p>
        </div>
        <%= link_to "Ver Calendário →", admin_calendar_path(view: "day"), class: "text-xs font-bold text-indigo-600 hover:text-indigo-700 py-1" %>
      </div>

      <% if @today_bookings.any? %>
        <div class="space-y-3">
          <% @today_bookings.each do |booking| %>
            <div class="p-3.5 sm:p-4 rounded-2xl bg-slate-50 border border-slate-200/60 flex items-center justify-between gap-3 hover:bg-slate-100/80 transition-colors">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-12 text-center shrink-0">
                  <span class="block text-sm font-extrabold text-slate-900 font-mono"><%= booking.starts_at.strftime("%H:%M") %></span>
                  <span class="block text-[10px] text-slate-400 font-medium"><%= booking.duration_minutes %>m</span>
                </div>
                <div class="border-l border-slate-200 pl-3 truncate">
                  <h4 class="text-sm font-bold text-slate-900 truncate"><%= booking.client.name %></h4>
                  <p class="text-xs text-slate-500 truncate"><%= booking.service.name %> · <%= booking.staff_member.name %></p>
                </div>
              </div>

              <div class="shrink-0">
                <% case booking.status %>
                <% when "confirmed" %>
                  <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[10px] sm:text-[11px] font-bold">Confirmado</span>
                <% when "completed" %>
                  <span class="px-2.5 py-1 rounded-full bg-blue-100 text-blue-800 text-[10px] sm:text-[11px] font-bold">Concluído</span>
                <% when "cancelled" %>
                  <span class="px-2.5 py-1 rounded-full bg-rose-100 text-rose-800 text-[10px] sm:text-[11px] font-bold">Cancelado</span>
                <% else %>
                  <span class="px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 text-[10px] sm:text-[11px] font-bold"><%= booking.status.titleize %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8 sm:py-10 px-4 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
          <p class="text-2xl mb-1">☕</p>
          <p class="text-sm font-bold text-slate-700">Nenhum agendamento para hoje</p>
          <p class="text-xs text-slate-400 mt-1">Os agendamentos feitos pelos seus clientes aparecerão aqui.</p>
        </div>
      <% end %>
    </div>

    <!-- Upcoming Bookings -->
    <div class="bg-white p-5 sm:p-6 rounded-3xl border border-slate-200/80 shadow-xs">
      <div class="flex items-center justify-between mb-5 sm:mb-6">
        <div>
          <h3 class="text-base font-bold text-slate-900">Próximos Agendamentos</h3>
          <p class="text-xs text-slate-500">Próximos horários marcados</p>
        </div>
        <%= link_to "Ver Todos →", admin_bookings_path, class: "text-xs font-bold text-indigo-600 hover:text-indigo-700 py-1" %>
      </div>

      <% if @upcoming_bookings.any? %>
        <div class="space-y-3">
          <% @upcoming_bookings.each do |booking| %>
            <div class="p-3.5 sm:p-4 rounded-2xl bg-slate-50 border border-slate-200/60 flex items-center justify-between gap-3">
              <div class="min-w-0">
                <span class="text-xs font-bold text-indigo-600 block"><%= booking.starts_at.strftime("%d/%m/%Y às %H:%M") %></span>
                <h4 class="text-sm font-bold text-slate-900 mt-0.5 truncate"><%= booking.client.name %></h4>
                <p class="text-xs text-slate-500 truncate"><%= booking.service.name %> (<%= booking.formatted_price %>)</p>
              </div>

              <%= link_to "Detalhes", admin_booking_path(booking), class: "text-xs font-bold text-slate-700 hover:text-slate-900 px-3 py-1.5 rounded-xl bg-white border border-slate-200 hover:bg-slate-50 shadow-xs shrink-0" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8 sm:py-10 px-4 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
          <p class="text-2xl mb-1">🚀</p>
          <p class="text-sm font-bold text-slate-700">Tudo pronto para receber agendamentos</p>
          <p class="text-xs text-slate-400 mt-1">Divulgue o link da sua agenda para começar a receber reservas.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
