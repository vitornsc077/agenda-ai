<%= form_with model: [:admin, service], class: "space-y-6" do |f| %>
  <% if service.errors.any? %>
    <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm">
      <p class="font-bold mb-1">Por favor corrija os erros abaixo:</p>
      <ul class="list-disc list-inside text-xs space-y-1">
        <% service.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-6">
    <div>
      <%= f.label :name, "Nome do Serviço", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
      <%= f.text_field :name, required: true, placeholder: "Ex: Corte Masculino, Consulta Terapia, Manicure", class: "w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" %>
    </div>

    <div>
      <%= f.label :description, "Descrição (opcional)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
      <%= f.text_area :description, rows: 3, placeholder: "Explique brevemente o que está incluso no serviço...", class: "w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div>
        <%= f.label :duration_minutes, "Duração do Atendimento (minutos)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
        <%= f.select :duration_minutes, options_for_select([["15 minutos", 15], ["30 minutos", 30], ["45 minutos", 45], ["60 minutos (1h)", 60], ["90 minutos (1h30)", 90], ["120 minutos (2h)", 120]], service.duration_minutes), {}, class: "w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm bg-white" %>
      </div>

      <div>
        <%= f.label :price_reais, "Preço (R$)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
        <%= f.number_field :price_reais, value: (service.price_cents ? service.price_reais : ""), step: 0.01, placeholder: "0,00 (Deixe em branco se for gratuito)", class: "w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" %>
      </div>
    </div>

    <!-- Staff selection -->
    <% if staff_members.any? %>
      <div class="pt-4 border-t border-slate-100">
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-3">Profissionais que realizam este serviço</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <% staff_members.each do |staff| %>
            <label class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
              <%= check_box_tag "service[staff_member_ids][]", staff.id, service.staff_member_ids.include?(staff.id), class: "w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500" %>
              <div class="truncate">
                <span class="text-sm font-semibold text-slate-900 block truncate"><%= staff.name %></span>
                <span class="text-xs text-slate-500 truncate"><%= staff.email %></span>
              </div>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="flex items-center gap-3 pt-2">
      <%= f.check_box :active, class: "w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500" %>
      <%= f.label :active, "Serviço ativo para agendamentos online", class: "text-sm font-medium text-slate-700 cursor-pointer" %>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancelar", admin_services_path, class: "px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-100 transition-colors" %>
    <%= f.submit (service.new_record? ? "Criar Serviço" : "Salvar Alterações"), class: "px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold shadow-md shadow-indigo-600/30 transition-all cursor-pointer" %>
  </div>
<% end %>
