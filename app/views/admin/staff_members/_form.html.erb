<%= form_with model: [:admin, staff_member], class: "space-y-6" do |f| %>
  <% if staff_member.errors.any? %>
    <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm">
      <p class="font-bold mb-1">Por favor corrija os erros abaixo:</p>
      <ul class="list-disc list-inside text-xs space-y-1">
        <% staff_member.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div>
        <%= f.label :name, "Nome do Profissional", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
        <%= f.text_field :name, required: true, placeholder: "Ex: Dr. Roberto, Camila Santos", class: "w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" %>
      </div>

      <div>
        <%= f.label :email, "E-mail para notificações", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
        <%= f.email_field :email, required: true, placeholder: "profissional@email.com", class: "w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" %>
      </div>
    </div>

    <div>
      <%= f.label :phone, "WhatsApp / Telefone (opcional)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
      <%= f.telephone_field :phone, placeholder: "(11) 99999-9999", class: "w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" %>
    </div>

    <div>
      <%= f.label :bio, "Biografia / Especialidade (opcional)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
      <%= f.text_area :bio, rows: 3, placeholder: "Breve apresentação do profissional para os clientes...", class: "w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm" %>
    </div>

    <!-- Services selection -->
    <% if services.any? %>
      <div class="pt-4 border-t border-slate-100">
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-3">Serviços que este profissional realiza</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <% services.each do |service| %>
            <label class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
              <%= check_box_tag "staff_member[service_ids][]", service.id, staff_member.service_ids.include?(service.id), class: "w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500" %>
              <div class="truncate">
                <span class="text-sm font-semibold text-slate-900 block truncate"><%= service.name %></span>
                <span class="text-xs text-slate-500 truncate"><%= service.duration_minutes %>min · <%= service.formatted_price %></span>
              </div>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="flex items-center gap-3 pt-2">
      <%= f.check_box :active, class: "w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500" %>
      <%= f.label :active, "Profissional ativo para receber agendamentos", class: "text-sm font-medium text-slate-700 cursor-pointer" %>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancelar", admin_staff_members_path, class: "px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-100 transition-colors" %>
    <%= f.submit (staff_member.new_record? ? "Cadastrar Profissional" : "Salvar Alterações"), class: "px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold shadow-md shadow-indigo-600/30 transition-all cursor-pointer" %>
  </div>
<% end %>
