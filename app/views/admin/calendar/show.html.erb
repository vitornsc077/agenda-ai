<% content_for :title, "Calendário" %>

<div class="space-y-6">
  <!-- Calendar Header Controls -->
  <div class="bg-white p-4 sm:p-6 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
    <!-- Date Navigation -->
    <div class="flex items-center gap-3">
      <% prev_date = case @view_mode
                     when "day" then @current_date - 1.day
                     when "month" then @current_date - 1.month
                     else @current_date - 1.week
                     end %>

      <% next_date = case @view_mode
                     when "day" then @current_date + 1.day
                     when "month" then @current_date + 1.month
                     else @current_date + 1.week
                     end %>

      <div class="flex items-center rounded-xl border border-slate-200 bg-slate-50 p-1 shadow-2xs">
        <%= link_to admin_calendar_path(view: @view_mode, date: prev_date, staff_member_id: @selected_staff_id, service_id: @selected_service_id), class: "p-2 hover:bg-white rounded-lg text-slate-600 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        <% end %>

        <%= link_to "Hoje", admin_calendar_path(view: @view_mode, date: Date.current, staff_member_id: @selected_staff_id, service_id: @selected_service_id), class: "px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-white rounded-lg transition-colors" %>

        <%= link_to admin_calendar_path(view: @view_mode, date: next_date, staff_member_id: @selected_staff_id, service_id: @selected_service_id), class: "p-2 hover:bg-white rounded-lg text-slate-600 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <% end %>
      </div>

      <h2 class="text-base font-extrabold text-slate-900">
        <% case @view_mode %>
        <% when "day" %>
          <%= @current_date.strftime("%d de %B de %Y") %>
        <% when "month" %>
          <%= @current_date.strftime("%B %Y") %>
        <% else %>
          Semana de <%= @current_date.beginning_of_week.strftime("%d/%m") %> a <%= @current_date.end_of_week.strftime("%d/%m/%Y") %>
        <% end %>
      </h2>
    </div>

    <!-- Filters and View Switcher -->
    <div class="flex flex-wrap items-center gap-3">
      <!-- Staff selector -->
      <%= form_with url: admin_calendar_path, method: :get, class: "flex items-center gap-2" do %>
        <%= hidden_field_tag :view, @view_mode %>
        <%= hidden_field_tag :date, @current_date %>
        <%= select_tag :staff_member_id, options_for_select([["Todos os Profissionais", ""]] + @staff_members.map { |s| [s.name, s.id] }, @selected_staff_id), class: "px-3 py-1.5 rounded-xl border border-slate-200 text-xs bg-white text-slate-700 focus:ring-indigo-500", onchange: "this.form.submit()" %>
      <% end %>

      <!-- View buttons (Day, Week, Month) -->
      <div class="flex items-center rounded-xl bg-slate-100 p-1">
        <%= link_to "Dia", admin_calendar_path(view: "day", date: @current_date, staff_member_id: @selected_staff_id), class: "px-3 py-1 text-xs font-bold rounded-lg transition-colors #{@view_mode == 'day' ? 'bg-white text-indigo-600 shadow-xs' : 'text-slate-600 hover:text-slate-900'}" %>
        <%= link_to "Semana", admin_calendar_path(view: "week", date: @current_date, staff_member_id: @selected_staff_id), class: "px-3 py-1 text-xs font-bold rounded-lg transition-colors #{@view_mode == 'week' ? 'bg-white text-indigo-600 shadow-xs' : 'text-slate-600 hover:text-slate-900'}" %>
        <%= link_to "Mês", admin_calendar_path(view: "month", date: @current_date, staff_member_id: @selected_staff_id), class: "px-3 py-1 text-xs font-bold rounded-lg transition-colors #{@view_mode == 'month' ? 'bg-white text-indigo-600 shadow-xs' : 'text-slate-600 hover:text-slate-900'}" %>
      </div>
    </div>
  </div>

  <!-- Calendar Content View -->
  <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden p-6">
    <% if @view_mode == "week" %>
      <!-- Week Grid (7 columns) -->
      <div class="grid grid-cols-7 gap-3 min-w-[700px]">
        <% (0..6).each do |offset| %>
          <% day = @current_date.beginning_of_week + offset.days %>
          <% day_bookings = @bookings.select { |b| b.starts_at.to_date == day } %>
          <% is_today = day == Date.current %>

          <div class="rounded-2xl border <%= is_today ? 'border-indigo-400 bg-indigo-50/30 ring-2 ring-indigo-500/20' : 'border-slate-100 bg-slate-50/50' %> p-3 min-h-[360px] flex flex-col">
            <div class="text-center pb-3 border-b border-slate-200/60 mb-3">
              <span class="block text-[11px] font-bold uppercase <%= is_today ? 'text-indigo-600' : 'text-slate-400' %>"><%= WorkSchedule::DAYS[day.wday][0..2] %></span>
              <span class="inline-flex w-7 h-7 items-center justify-center rounded-full text-sm font-extrabold <%= is_today ? 'bg-indigo-600 text-white shadow-xs' : 'text-slate-800' %>"><%= day.day %></span>
            </div>

            <div class="space-y-2 flex-1 overflow-y-auto">
              <% if day_bookings.any? %>
                <% day_bookings.sort_by(&:starts_at).each do |booking| %>
                  <%= link_to admin_booking_path(booking), class: "block p-2.5 rounded-xl bg-white border border-slate-200/80 shadow-2xs hover:border-indigo-400 hover:shadow-xs transition-all text-left" do %>
                    <span class="text-[11px] font-bold text-indigo-600 block"><%= booking.starts_at.strftime("%H:%M") %> - <%= booking.ends_at.strftime("%H:%M") %></span>
                    <span class="text-xs font-bold text-slate-900 block truncate"><%= booking.client.name %></span>
                    <span class="text-[10px] text-slate-500 block truncate"><%= booking.service.name %></span>
                  <% end %>
                <% end %>
              <% else %>
                <div class="h-full flex items-center justify-center">
                  <span class="text-[11px] text-slate-400 italic">Livre</span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

    <% elsif @view_mode == "day" %>
      <!-- Day View (Time slots) -->
      <div class="max-w-2xl mx-auto space-y-3">
        <% day_bookings = @bookings.select { |b| b.starts_at.to_date == @current_date } %>
        <% if day_bookings.any? %>
          <div class="divide-y divide-slate-100">
            <% day_bookings.sort_by(&:starts_at).each do |booking| %>
              <div class="py-4 flex items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                  <div class="w-16 text-center font-mono font-bold text-slate-900">
                    <span class="text-base"><%= booking.starts_at.strftime("%H:%M") %></span>
                    <span class="block text-[10px] text-slate-400"><%= booking.duration_minutes %>m</span>
                  </div>
                  <div class="border-l-2 border-indigo-500 pl-4">
                    <h4 class="text-sm font-bold text-slate-900"><%= booking.client.name %></h4>
                    <p class="text-xs text-slate-500"><%= booking.service.name %> · Profissional: <%= booking.staff_member.name %></p>
                  </div>
                </div>

                <%= link_to "Ver Detalhes", admin_booking_path(booking), class: "px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-xs font-semibold text-slate-700" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-12 text-slate-400">
            <p class="text-3xl mb-2">☀️</p>
            <p class="text-sm font-bold text-slate-600">Nenhum compromisso marcado para este dia.</p>
          </div>
        <% end %>
      </div>

    <% else %>
      <!-- Month View (Calendar Table) -->
      <div class="grid grid-cols-7 gap-2">
        <% ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"].each do |w| %>
          <div class="text-center font-bold text-xs uppercase text-slate-400 py-2"><%= w %></div>
        <% end %>

        <% first_day = @current_date.beginning_of_month.beginning_of_week %>
        <% last_day = @current_date.end_of_month.end_of_week %>
        <% (first_day..last_day).each do |day| %>
          <% day_bookings = @bookings.select { |b| b.starts_at.to_date == day } %>
          <% is_current_month = day.month == @current_date.month %>
          <% is_today = day == Date.current %>

          <div class="p-2 min-h-[90px] rounded-xl border <%= is_today ? 'border-indigo-400 bg-indigo-50/20' : 'border-slate-100 bg-white' %> <%= 'opacity-40' unless is_current_month %> flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold <%= is_today ? 'text-indigo-600' : 'text-slate-700' %>"><%= day.day %></span>
              <% if day_bookings.any? %>
                <span class="w-5 h-5 rounded-full bg-indigo-600 text-white text-[10px] font-bold flex items-center justify-center"><%= day_bookings.count %></span>
              <% end %>
            </div>

            <div class="space-y-1 mt-1">
              <% day_bookings.take(2).each do |b| %>
                <div class="text-[10px] bg-slate-100 text-slate-800 rounded px-1 truncate font-medium">
                  <%= b.starts_at.strftime("%H:%M") %> <%= b.client.name.split.first %>
                </div>
              <% end %>
              <% if day_bookings.count > 2 %>
                <span class="text-[9px] text-slate-400 block">+<%= day_bookings.count - 2 %> mais</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
