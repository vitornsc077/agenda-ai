<% content_for :title, "Criar Conta · Teste Grátis de 14 Dias" %>

<div class="w-full max-w-lg my-auto py-4 sm:py-8">
  <div class="w-full space-y-6 sm:space-y-8 bg-slate-900/90 border border-slate-800 p-6 sm:p-10 rounded-3xl shadow-2xl backdrop-blur-xl">
    <!-- Header -->
    <div class="text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 text-xs font-bold mb-3 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        14 dias grátis · Sem cartão de crédito
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">Comece sua agenda online</h2>
      <p class="mt-2 text-xs sm:text-sm text-slate-400">
        Já tem uma conta?
        <%= link_to "Entrar aqui", new_session_path, class: "font-semibold text-indigo-400 hover:text-indigo-300 transition-colors" %>
      </p>
    </div>

    <!-- Form -->
    <%= form_with url: registration_path, method: :post, class: "mt-6 sm:mt-8 space-y-5" do |f| %>
      <div>
        <%= label_tag :account_name, "Nome do seu negócio / Empresa", class: "block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5" %>
        <%= text_field_tag :account_name, params[:account_name], required: true, autofocus: true, placeholder: "Ex: Barbearia VIP, Clínica Dr. Silva, Salão da Ana", class: "w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm transition-all min-h-[44px]" %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= label_tag :name, "Seu nome", class: "block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5" %>
          <%= text_field_tag :name, params[:name], required: true, placeholder: "Seu nome completo", class: "w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm transition-all min-h-[44px]" %>
        </div>

        <div>
          <%= label_tag :email, "Seu e-mail", class: "block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5" %>
          <%= email_field_tag :email, params[:email], required: true, placeholder: "seu@email.com", class: "w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm transition-all min-h-[44px]" %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= label_tag :password, "Senha", class: "block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5" %>
          <%= password_field_tag :password, nil, required: true, placeholder: "Mínimo 6 dígitos", class: "w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm transition-all min-h-[44px]" %>
        </div>

        <div>
          <%= label_tag :password_confirmation, "Confirmar Senha", class: "block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5" %>
          <%= password_field_tag :password_confirmation, nil, required: true, placeholder: "Repita a senha", class: "w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm transition-all min-h-[44px]" %>
        </div>
      </div>

      <div class="pt-2">
        <%= submit_tag "Criar Minha Agenda Grátis →", class: "w-full py-3.5 px-4 bg-gradient-to-r from-emerald-600 via-teal-600 to-indigo-600 hover:from-emerald-500 hover:to-indigo-500 text-white font-bold rounded-xl shadow-lg shadow-emerald-600/30 transition-all duration-200 cursor-pointer text-sm transform active:scale-95 min-h-[44px]" %>
      </div>
    <% end %>
  </div>
</div>
